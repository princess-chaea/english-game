# Set these in Vercel Project Settings > Environment Variables. Never commit a service-account key.
FIREBASE_PROJECT_ID=vocahero-1876a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@vocahero-1876a.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=vocahero-1876a.firebasestorage.app
CRON_SECRET=use-a-long-random-value-for-vercel-cron
LEGACY_MIGRATION_RETENTION_DAYS=60
# Any verified Google account can open the teacher portal.
# Guild management remains locked until employment-certificate verification approves the teacher.

# Comma-separated Google accounts allowed to review redacted teacher certificates.
TEACHER_REVIEWER_EMAILS=reviewer@example.com
