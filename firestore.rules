rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Word lists are the only client-readable data. Every account, class, invite,
    // and leaderboard mutation is handled by Firebase Admin in /api.
    match /game_data/words {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
